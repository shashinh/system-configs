// nostromo — Framework 13 (AMD 7040)
//
// Host-specific niri configuration: display layout. Included by config.kdl as
// `include "host.kdl"`; home-manager links ~/.config/niri/host.kdl to the file
// named after this machine.
//
// niri resolves includes relative to the directory of the config file it was
// given (~/.config/niri), not the symlink target, so this composes correctly
// even though config.kdl itself is a symlink into the repo.

// Primary laptop display - default spec is 2256x1504@59.999
// Mod+Shift+1 hotkey-overlay-title="Turn on/off eDP-1" {spawn-sh "niri msg outputs | grep -n2 eDP | grep -q Disabled && { echo off; niri msg output eDP-1 on; } || { echo on; niri msg output eDP-1 off; }";}
output "eDP-1" {
    // Uncomment this line to disable this output.
    // off

    // Resolution and, optionally, refresh rate of the output.
    // The format is "<width>x<height>" or "<width>x<height>@<refresh rate>".
    // If the refresh rate is omitted, niri will pick the highest refresh rate
    // for the resolution.
    // If the mode is omitted altogether or is invalid, niri will pick one automatically.
    // Run `niri msg outputs` while inside a niri instance to list all outputs and their modes.
    mode "2256x1504@59.999"

    // You can use integer or fractional scale, for example use 1.5 for 150% scale.
    // 1.375 rather than 1.35: see "Pixel-exact column widths" below.
    scale 1.375

    // Transform allows to rotate the output counter-clockwise, valid values are:
    // normal, 90, 180, 270, flipped, flipped-90, flipped-180 and flipped-270.
    transform "normal"

    // Position of the output in the global coordinate space.
    // This affects directional monitor actions like "focus-monitor-left", and cursor movement.
    // The cursor can only move between directly adjacent outputs.
    // Output scale and rotation has to be taken into account for positioning:
    // outputs are sized in logical, or scaled, pixels.
    // For example, a 3840×2160 output with scale 2.0 will have a logical size of 1920×1080,
    // so to put another output directly adjacent to it on the right, set its x to 1920.
    // If the position is unset or results in an overlap, the output is instead placed
    // automatically.
    position x=0 y=0

    // Pixel-exact column widths (see the note above the shared layout block).
    // At scale 1.375 = 11/8 a logical size is exact when it is a multiple of 8.
    // The panel is 2256 px = 1640.73 logical; the 1 px right strut trims the
    // working area to exactly 1640, so the presets resolve to
    //   1/3 = 536, 1/2 = 808, 2/3 = 1080
    //   (3*536 + 4*8 = 2*808 + 3*8 = 536 + 1080 + 3*8 = 1640).
    layout {
      gaps 8
      struts { right 0.7272727272727273; }
      default-column-width { proportion 0.66667; }
    }
}

// home monitor
output "LG Electronics LG HDR WQHD 307MXZJ91253" {
  // off
  mode "3440x1440@84.979"
  scale 1
  transform "normal"
  // this is sketchy, needs to be computed based on scaling of previous monitor.
  // turned off for now, since niri appears to park monitors on the right anyways.
  // position x=1671 y=0
}

// Output "Dell Inc. DELL U2723QE F46X3P3" (DP-2)
//   Current mode: 3840x2160 @ 59.997 Hz (preferred)
//   Variable refresh rate: not supported
//   Physical size: 600x340 mm
//   Logical position: 0, 0
//   Logical size: 2560x1440
//   Scale: 1.5
//   Transform: normal
//   Available modes:
//     3840x2160@59.997 (current, preferred)
output "Dell Inc. DELL U2723QE F46X3P3" {
  // off
  mode "3840x2160@59.997"
  scale 1.5
  transform "normal"
  // TODO figure out logical position wrt internal display

  // Pixel-exact column widths (see the note above the shared layout block).
  // At scale 1.5 a logical size is exact when it is an even integer. The
  // struts trim the 2560-wide screen to a working area of 2552, so the
  // presets resolve to
  //   1/3 = 840, 1/2 = 1264, 2/3 = 1688
  //   (3*840 + 4*8 = 2*1264 + 3*8 = 840 + 1688 + 3*8 = 2552).
  layout {
    gaps 8
    struts { left 4; right 4; }
  }
}

// ─── Layout: column widths ──────────────────────────────────────────────────
// Mod+R cycles the presets; new windows open at default-column-width.
//
// The presets are thirds and a half of the working area. The thirds are
// rounded *up* (0.33334, not 0.33333) on purpose: niri floors the resolved
// width to a whole pixel, so a proportion a hair under 1/3 lands one pixel
// short.
//
// The two fractionally scaled outputs above set their own gaps and struts so
// that these proportions resolve to pixel-exact widths. niri lays columns out
// in logical pixels using exact floating-point comparisons, and at a
// fractional scale most widths have no exact binary representation (843.33
// at scale 1.5). The rounding error then decides whether a column "fits":
// two columns that should fill the screen overflow by a hair, and
// expand-column-to-available-width sees the neighbour as off-screen and
// maximizes instead. Keeping every width and gap a whole number of physical
// pixels *and* exactly representable in logical pixels keeps the arithmetic
// exact. When changing a scale, gap or strut on those outputs, re-derive the
// widths: (working width - gaps) * proportion - gaps must come out exact for
// each preset.
layout {
    preset-column-widths {
        proportion 0.33334
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    //center-focused-column "on-overflow"
    always-center-single-column
}

// ─── Laptop input devices (merged into the shared input section) ────────────
input {
    touchpad {
        tap
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // disabled-on-external-mouse
    }
    trackpoint {
        // natural-scroll
        // accel-speed 0.2
    }
}

// ─── Host-only binds ────────────────────────────────────────────────────────
binds {
    // Turn the internal display on/off, for when the laptop is docked to the
    // external monitors (untested).
    Mod+Shift+1 hotkey-overlay-title="Turn on/off eDP-1" {spawn-sh "niri msg outputs | grep -n2 eDP | grep -q Disabled && { echo off; niri msg output eDP-1 on; } || { echo on; niri msg output eDP-1 off; }";}
}

workspace "chat" {
  open-on-output "DP-2"
}

