layout {

    focus-ring {
        active-color   "#bcd063"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bcd063"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bcd063"
        inactive-color "#404c00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bcd06380"
    }
}

recent-windows {
    highlight {
        active-color "#bcd063"
        urgent-color "#ffb4ab"
    }
}
