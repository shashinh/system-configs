;; EMERGENCY EXIT: hold Left Ctrl + Space + Escape together to force-quit
;; kanata and restore normal keyboard behavior.

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt spc  ralt rctl
  left down up   rght
  home end  pgup pgdn
)

(defvar
  ;; home-row-mods, advanced variant - GACS-SCAG layout
  ;; https://github.com/jtroo/kanata/blob/main/cfg_samples/home-row-mod-advanced.kbd
  ;; https://precondition.github.io/home-row-mods
  ;;
  ;; - same-hand key press while a home row mod is held resolves it as a tap
  ;;   early (fast rollover typing never eats a letter)
  ;; - opposite-hand key press+release while held resolves it as a hold
  ;;   early (cross-hand chords like ctrl+l stay snappy, no full hold-time
  ;;   wait)
  ;; - once a tap resolves, home row mods disable entirely until 20ms of
  ;;   idle time, so a fast typing burst can't misfire mid-burst
  ;;
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 150

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

;; home row mods + HHKB-styled backspace
(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    \
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    @bspc-del
  esc @a   @s   @d   @f   g    h    @j   @k   @l   @;   '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt @spc ralt rctl
  left down up   rght
  home end  pgup pgdn
)

(deflayer nomods
  grv  1    2    3    4    5    6    7    8    9    0    -    =    \
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    @bspc-del
  esc a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt @spc ralt rctl
  left down up   rght
  home end  pgup pgdn
)

;; space held + hjkl = arrow keys
(deflayer nav
  grv  1    2    3    4    5    6    7    8    9    0    -    =    \
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    @bspc-del
  esc  a    s    d    f    g    left down up   rght ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt XX   ralt rctl
  left down up   rght
  home end  pgup pgdn
)

(deffakekeys
  to-base (layer-switch base)
)

(defalias
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  a (tap-hold-release-keys $tap-time 220 (multi a @tap) lmet $left-hand-keys)
  s (tap-hold-release-keys $tap-time $hold-time (multi s @tap) lalt $left-hand-keys)
  d (tap-hold-release-keys $tap-time $hold-time (multi d @tap) lctl $left-hand-keys)
  f (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)
  j (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rsft $right-hand-keys)
  k (tap-hold-release-keys $tap-time $hold-time (multi k @tap) rctl $right-hand-keys)
  l (tap-hold-release-keys $tap-time $hold-time (multi l @tap) ralt $right-hand-keys)
  ; (tap-hold-release-keys $tap-time 220 (multi ; @tap) rmet $right-hand-keys)

  ;; shift+backspace=del
  bspc-del (fork bspc (unshift del) (lsft rsft))

  ;; space held + hjkl = arrow keys
  spc (tap-hold-release $tap-time $hold-time spc (layer-while-held nav))
)
